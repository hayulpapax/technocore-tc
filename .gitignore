# 개인키 — 절대 커밋 금지
keys/
*.pem
identity.json

# 공식 문서 원본 스냅샷(로컬 참고용). 재배포하지 않고 링크로 대체한다.
docs/

# Windows reserved device name. A tool run with GITHUB_OUTPUT=/dev/null on this
# platform leaves one behind, and git cannot index a path the OS reserves — it
# blocks every later `git add -A` until it is ignored.
nul

# 대회용 추가 키 (close-1 등). identity.json 은 위에서 이미 막지만 nonce 도 올리지 않는다.
keys-*/
# 로컬 실행 기록 (ladder 등)
logs/
